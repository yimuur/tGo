# ============================================================================
# tGo systemd 服务单元模板（T7.3）—— 由 deploy.sh 渲染安装到
# /etc/systemd/system/tgo.service（安装时替换路径/用户占位符）。
#
# 关键说明：
#   - KillMode=process：退出时仅向主进程（python）转发 SIGTERM，由应用完成引擎
#     优雅退出序列（stdin 关闭 → terminate → kill）；systemd 默认的 control-group
#     会同时向 katago 直发 SIGTERM（绕过退出序列，存在竞态误报）。
#   - 端口冲突自动 +1 / 已在运行的 tGo 幂等复用：由 app.launcher 统一处理。
#   - 用户状态（config.yaml / data/ / logs/ / engine/models）为外部数据，
#     升级/重装本单元均不触碰。
# ============================================================================

[Unit]
Description=tGo · KataGo Web 对弈与分析平台
Documentation=file:@ROOT@/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@/backend
Environment=PYTHONUTF8=1
Environment=PYTHONUNBUFFERED=1
ExecStart=@VENV_PY@ -m app.launcher
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=process

[Install]
WantedBy=multi-user.target
